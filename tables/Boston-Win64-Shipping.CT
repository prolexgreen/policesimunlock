        <CheatEntry>
          <ID>338</ID>
          <Description>"Unlimited Jumps"</Description>
          <Options moAlwaysHideChildren="1"/>
          <Color>FFFF80</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}

if syntaxcheck then return end

getHotkeyHandlerThread().state = 'htsActive'

if not MyRec then MyRec = {} end
local base = getAddress("[[[[[[uworld]+180]+38]+0]+30]+2A0]")
if not base then return end
local addr1 = base + 0x344
local addr2 = base + 0x348

local base2 = getAddress("[[[[[[[uworld]+180]+38]+0]+30]+2A0]+288]")
if not base2 then return end
local addr3 = base2 + 0x1C4
local addr4 = base2 + 0x158

MyRec.addr1 = addr1
MyRec.addr2 = addr2
MyRec.addr3 = addr3
MyRec.addr4 = addr4

MyRec.orig1 = readInteger(addr1)
MyRec.orig2 = readInteger(addr2)
MyRec.orig3 = readFloat(addr3)
MyRec.orig4 = readFloat(addr4)

writeInteger(addr1, 2)
writeInteger(addr2, 0)
writeFloat(addr3, 9999)
writeFloat(addr4, 750)

MyRec.freezeTimer = createTimer(nil, false)
MyRec.freezeTimer.Interval = 50
MyRec.freezeTimer.OnTimer = function(t)
  writeInteger(addr1, 2)
  writeInteger(addr2, 0)
  writeFloat(addr3, 9999)
  writeFloat(addr4, 750)
end

MyRec.freezeTimer.Enabled = true

{$asm}

[DISABLE]

{$lua}

getHotkeyHandlerThread().state = 'htsDisabled'

if MyRec then
  if MyRec.freezeTimer then
    MyRec.freezeTimer:destroy()
    MyRec.freezeTimer = nil
  end
  if MyRec.addr1 then writeInteger(MyRec.addr1, MyRec.orig1) end
  if MyRec.addr2 then writeInteger(MyRec.addr2, MyRec.orig2) end
  if MyRec.addr3 then writeFloat(MyRec.addr3, MyRec.orig3) end
  if MyRec.addr4 then writeFloat(MyRec.addr4, MyRec.orig4) end
end

{$asm}
</AssemblerScript>
